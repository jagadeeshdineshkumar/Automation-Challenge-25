{
  "name": "sauce-demo-mobile-automation",
  "version": "1.0.0",
  "description": "End-to-end checkout automation for the Sauce Labs My Demo App (React Native, Android) using CodeceptJS + Appium",
  "private": true,
  "scripts": {
    "test": "codeceptjs run --steps",
    "test:verbose": "codeceptjs run --verbose",
    "test:report": "codeceptjs run --steps --reporter mochawesome",
    "appium": "appium --allow-cors --base-path /",
    "emulator": "$HOME/Library/Android/sdk/emulator/emulator -avd ${AVD:-Pixel_5_API_31} -no-snapshot-load"
  },
  "devDependencies": {
    "codeceptjs": "^3.6.10",
    "mochawesome": "^7.1.3",
    "webdriverio": "^8.40.6"
  }
}
